# ══════════════════════════════════════════════════════════════════
# Copy to .env for local development:   cp .env.example .env
# ══════════════════════════════════════════════════════════════════
# .env is for LOCAL CONVENIENCE ONLY and must never be committed
# (the repo .gitignore already excludes it).
#
# On AWS, these values are set as Lambda/ECS environment variables by
# the CloudFormation templates instead — see infra-lambda.yaml and
# infra-fargate.yaml. Nothing reads a .env file in production.
#
# REAL SECRETS (API keys, DB passwords, tokens) do NOT belong here even
# locally. Use AWS Secrets Manager or SSM Parameter Store and fetch them
# at startup. A .env file is one `git add .` away from being public.
# ══════════════════════════════════════════════════════════════════

# ── Which storage backend to use: json | dynamodb ──────────────────
# Stage 1 (no AWS needed):
STORAGE=json
# Stage 2 (needs a DynamoDB table or DynamoDB Local):
# STORAGE=dynamodb

# ── Used when STORAGE=json ─────────────────────────────────────────
BOOKS_FILE=books.json

# ── Used when STORAGE=dynamodb ─────────────────────────────────────
TABLE_NAME=book-store-books
AWS_REGION=us-east-1

# Point boto3 at DynamoDB Local instead of real AWS (see docs/03).
# Leave EMPTY to talk to real AWS.
DYNAMODB_ENDPOINT_URL=
# DYNAMODB_ENDPOINT_URL=http://localhost:8001

# ── Free-form label surfaced by GET /health ────────────────────────
ENV=local
